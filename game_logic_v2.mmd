flowchart TD
    subgraph Core["Core Influence Map (resolved once at End Turn)"]
        direction LR
        Heat["Heat (-10 to +10)<br/>0 is ideal"]
        Air["Air (-10 to 0)<br/>0 is ideal"]
        Water["Water (-10 to +10)<br/>0 is ideal"]
        Soil["Soil (-10 to 0)<br/>0 is ideal"]

        Heat -->|"if abs(Heat)>=5: Water += -sign(Heat)"| Water
        Heat -->|"if abs(Heat)>=5: Soil += -sign(Heat)"| Soil
        Air -->|"if abs(Air)>=5: Heat += sign(Air)"| Heat
        Air -->|"if abs(Air)>=5: Water += sign(Air)"| Water
        Water -->|"if abs(Water)>=5: Soil += sign(Water)"| Soil
        Water -->|"if abs(Water)>=5: Air += sign(Water)"| Air
        Soil -->|"if abs(Soil)>=5: Air += sign(Soil)"| Air
    end

    subgraph Turn["Turn Sequence"]
        direction TB
        T1["Play cards<br/>(change Heat/Air/Water/Soil)"]
        T2["End Turn"]
        T3["Apply hazard deltas"]
        T4["Apply Core Influence Map"]
        T5["Score Habitability delta<br/>vs world target profile"]
        T6{"Goal reached?"}
        T7{"Turn limit hit?"}
        T8["Next turn<br/>discard hand, draw 5, reset energy"]
        T9["World clear"]
        T10["Run failed"]

        T1 --> T2 --> T3 --> T4 --> T5 --> T6
        T6 -->|Yes| T9
        T6 -->|No| T7
        T7 -->|Yes| T10
        T7 -->|No| T8 --> T1
    end
